---
/** CONTRACTS §3 — props: { tag: string; href?: string } */
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;

// A pill is a link when it can navigate, and inert text otherwise.
const Element = href ? 'a' : 'span';
---

<Element class="tag-pill" href={href}>{tag}</Element>

<style>
  .tag-pill {
    display: inline-block;
    max-width: 100%;
    padding: 0.1em 0.55em 0.15em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-bg);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .tag-pill::before {
    content: "#";
    opacity: 0.65;
  }

  a.tag-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  a.tag-pill:focus-visible {
    color: var(--color-accent);
  }
</style>
