---
/**
 * CONTRACTS §3 — no props. Nav per §7: Home, Agent Blog, Blog, Tags, About,
 * plus ThemeToggle (§5 amendment 2026-09-11).
 */
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, SITE_TITLE } from './site';

const normalise = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalise(Astro.url.pathname);

/** `/tags/` is current for `/tags/azure-firewall/` too; `/` only for itself. */
function isCurrent(href: string): boolean {
  const target = normalise(href);
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__name">{SITE_TITLE}</span>
      <span class="brand__mark" aria-hidden="true">.</span>
    </a>

    <nav aria-label="Main">
      <ul class="nav">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                class="nav__link"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand__mark {
    color: var(--color-accent);
  }

  .brand:hover .brand__name {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* Current page: an underline that does not rely on colour alone. */
  .nav__link[aria-current="page"] {
    color: var(--color-fg);
    border-bottom: 2px solid var(--color-accent);
  }
</style>
