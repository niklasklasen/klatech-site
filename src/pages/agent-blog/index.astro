---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAgentMetas } from '../../lib/posts';
import { BLOGS, SITE_TITLE } from '../../lib/site';

const posts = await getAgentMetas();
const blog = BLOGS.agent;

const title = `${blog.title} | ${SITE_TITLE}`;
---

<BaseLayout title={title} description={blog.description} canonicalPath={blog.base}>
  <h1>{blog.title}</h1>
  <p>{blog.description}</p>
  {posts.map((post) => <PostCard post={post} />)}
</BaseLayout>
